{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/manifest.json",
      "headers": [
        { "key": "Content-Type", "value": "application/manifest+json; charset=utf-8" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Content-Type", "value": "application/javascript; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/(pwa-192x192\\.png|pwa-512x512\\.png|pwa-maskable-512x512\\.png|apple-touch-icon\\.png|icon\\.svg|favicon\\.ico)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(self), geolocation=(), payment=(), usb=()" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin-allow-popups" }
      ]
    }
  ],
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 30
    }
  },
  "redirects": [
    {
      "source": "/((?!api(?:/|$)).*)",
      "has": [
        {
          "type": "host",
          "value": "sovereign-soc-platform-9wwm.vercel.app"
        }
      ],
      "destination": "https://sovqs.vercel.app/$1",
      "permanent": true
    },
    {
      "source": "/((?!api(?:/|$)).*)",
      "has": [
        {
          "type": "host",
          "value": "sovsoc.vercel.app"
        }
      ],
      "destination": "https://sovqs.vercel.app/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/__/auth/(.*)",
      "destination": "https://herculian-metric-0vc14.firebaseapp.com/__/auth/$1"
    },
    {
      "source": "/__/firebase/(.*)",
      "destination": "https://herculian-metric-0vc14.firebaseapp.com/__/firebase/$1"
    },
    {
      "source": "/((?!api(?:/|$)|__/|assets/|fonts/|manifest\\.json|sw\\.js|workbox-.*|sql-wasm\\.wasm|.*\\.(?:png|jpg|jpeg|svg|ico|wasm|ttf|js|css|json|txt|xml)$).*)",
      "destination": "/index.html"
    }
  ]
}

# Server-side Gemini API key (configured via Secret Manager / Cloud Run secrets or AI Studio Secrets)
GEMINI_API_KEY=your_gemini_api_key_here

# Cryptographic HMAC-SHA256 secret for tamper-evident Security Monitor hash chain (>= 32 bytes hex)
# Mount via GCP Secret Manager: --set-secrets=SECURITY_AUDIT_HMAC_KEY=security-audit-hmac-key:latest
SECURITY_AUDIT_HMAC_KEY=replace_with_64_hex_chars_from_secret_manager
# Optional Secret Manager mounted file path fallback (e.g. /secrets/security-audit-hmac-key)
# SECURITY_AUDIT_HMAC_KEY_FILE=/secrets/security-audit-hmac-key

# Comma-separated trusted CORS origins for cross-origin static hosting (e.g. GitHub Pages -> Cloud Run Backend)
# ALLOWED_CORS_ORIGINS=https://ivywcuseb-hash.github.io

# Optional frontend build-time API backend origin (when serving static frontend on GitHub Pages)
# VITE_API_BASE_URL=https://your-production-backend.run.app

# Runtime environment & port
NODE_ENV=production
PORT=3000

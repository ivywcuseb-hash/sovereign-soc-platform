{
  "entities": {
    "Evidence": {
      "title": "Evidence",
      "description": "Digital evidence file and its forensic metadata",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "investigationId": { "type": "string", "maxLength": 128 },
        "fileName": { "type": "string", "maxLength": 256 },
        "mimeType": { "type": "string", "maxLength": 128 },
        "fileSize": { "type": "number" },
        "storagePath": { "type": "string", "maxLength": 512 },
        "storageStatus": { "type": "string", "enum": ["cloud", "local"] },
        "fileUrl": { "type": "string", "maxLength": 2048 },
        "downloadUrl": { "type": "string", "maxLength": 2048 },
        "sha256": { "type": "string", "maxLength": 64, "pattern": "^[a-f0-9]{64}$" },
        "sha512": { "type": "string", "maxLength": 128 },
        "sha1": { "type": "string", "maxLength": 40 },
        "md5": { "type": "string", "maxLength": 32 },
        "exif": { "type": "object" },
        "analysis": {
          "type": "object",
          "properties": {
            "authenticityScore": { "type": "number" },
            "laplacianVariance": { "type": "number" },
            "riskLevel": { "type": "string" },
            "verdict": { "type": "string" }
          }
        },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [ "id", "userId", "investigationId", "fileName", "sha256", "createdAt" ]
    },
    "Investigation": {
      "title": "Investigation",
      "description": "A forensic investigation case container",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 256 },
        "description": { "type": "string", "maxLength": 1024 },
        "status": { "type": "string", "enum": ["active", "closed", "archived"] },
        "caseNumber": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [ "id", "userId", "title", "status", "createdAt" ]
    },
    "ChainOfCustody": {
      "title": "ChainOfCustody",
      "description": "Evidence handling history tracking",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "evidenceId": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "officerName": { "type": "string", "maxLength": 128 },
        "action": { "type": "string" },
        "location": { "type": "string" },
        "notes": { "type": "string" },
        "prevHash": { "type": "string", "maxLength": 64 },
        "recordHash": { "type": "string", "maxLength": 64 },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": [ "id", "evidenceId", "userId", "action", "timestamp" ]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "System-wide activity log",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "action": { "type": "string" },
        "targetId": { "type": "string" },
        "targetType": { "type": "string" },
        "details": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": [ "id", "userId", "action", "timestamp" ]
    },
    "CustodyLedgerEvent": {
      "title": "CustodyLedgerEvent",
      "description": "Immutable investigator-wide cryptographic chain of custody block",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "evidenceId": { "type": "string", "maxLength": 128 },
        "actionCategory": { "type": "string", "enum": ["EVIDENCE_UPLOAD", "FILE_INSPECTION", "SETTINGS_CHANGE", "MANUAL_CUSTODY", "REPORT_EXPORT", "LOG_ANALYSIS", "CASE_MANAGEMENT"] },
        "action": { "type": "string", "maxLength": 256 },
        "officerName": { "type": "string", "maxLength": 128 },
        "location": { "type": "string", "maxLength": 256 },
        "notes": { "type": "string", "maxLength": 1024 },
        "prevHash": { "type": "string", "maxLength": 64 },
        "recordHash": { "type": "string", "maxLength": 64 },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": [ "userId", "evidenceId", "actionCategory", "action", "prevHash", "recordHash", "timestamp" ]
    },
    "ForensicReport": {
      "title": "ForensicReport",
      "description": "Immutable sealed forensic report aggregating evidence and SHA-256 digests",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "investigationId": { "type": "string", "maxLength": 128 },
        "caseNumber": { "type": "string", "maxLength": 64 },
        "title": { "type": "string", "maxLength": 256 },
        "classification": { "type": "string", "enum": ["TOP_SECRET", "CONFIDENTIAL", "OFFICIAL"] },
        "examinerName": { "type": "string", "maxLength": 128 },
        "department": { "type": "string", "maxLength": 128 },
        "summary": { "type": "string", "maxLength": 2048 },
        "evidenceCount": { "type": "number" },
        "evidenceSha256List": { "type": "array" },
        "iocCount": { "type": "number" },
        "custodyCount": { "type": "number" },
        "reportSealSha256": { "type": "string", "maxLength": 64 },
        "exportFormat": { "type": "string", "maxLength": 32 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [ "userId", "caseNumber", "title", "classification", "examinerName", "evidenceCount", "reportSealSha256", "createdAt" ]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "User account and preferences",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string", "maxLength": 128 },
        "role": { "type": "string", "enum": ["analyst", "admin"] },
        "settings": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [ "uid", "email" ]
    },
    "AdminRegistry": {
      "title": "AdminRegistry",
      "description": "Server-side only administrator role registry (unreachable from client SDK)",
      "type": "object",
      "properties": {
        "active": { "type": "boolean" },
        "grantedAt": { "type": "string", "format": "date-time" }
      },
      "required": [ "active" ]
    },
    "SecurityEvent": {
      "title": "SecurityEvent",
      "description": "Tamper-proof server-recorded defensive monitoring event",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "timestamp": { "type": "string", "format": "date-time" },
        "eventType": { "type": "string" },
        "severity": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
        "route": { "type": "string", "maxLength": 128 },
        "method": { "type": "string", "maxLength": 16 },
        "clientIpHash": { "type": "string", "maxLength": 64 },
        "userId": { "type": ["string", "null"] },
        "detail": { "type": "string", "maxLength": 400 },
        "blocked": { "type": "boolean" },
        "prevHash": { "type": "string", "maxLength": 64 },
        "recordHash": { "type": "string", "maxLength": 64 }
      },
      "required": [ "id", "timestamp", "eventType", "severity", "prevHash", "recordHash" ]
    },
    "Subscription": {
      "title": "Subscription",
      "description": "User subscription status controlling access to paid forensic and SOC modules",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 320 },
        "plan": { "type": "string", "enum": ["free", "pro", "enterprise"] },
        "status": { "type": "string", "enum": ["active", "inactive", "expired", "revoked"] },
        "expiresAt": { "type": "string", "format": "date-time" },
        "grantedBy": { "type": "string", "maxLength": 128 },
        "notes": { "type": "string", "maxLength": 256 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [ "userId", "plan", "status", "createdAt", "updatedAt" ]
    },
    "PlatformToolConfig": {
      "title": "PlatformToolConfig",
      "description": "Owner-managed list of locked tools (lockedTools) enforced for non-subscribed users",
      "type": "object",
      "properties": {
        "lockedTools": { "type": "array" },
        "paidTabs": { "type": "array" },
        "updatedBy": { "type": "string", "maxLength": 128 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [ "lockedTools", "updatedAt" ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Primary user documents"
    },
    "/subscriptions/{userId}": {
      "schema": "Subscription",
      "description": "Admin-managed user subscription plans and status"
    },
    "/platform_config/{configId}": {
      "schema": "PlatformToolConfig",
      "description": "Owner-managed platform settings such as paid/free tool toggles"
    },
    "/admins/{adminId}": {
      "schema": "AdminRegistry",
      "description": "Server-only administrator registry"
    },
    "/security_events/{eventId}": {
      "schema": "SecurityEvent",
      "description": "Server-only tamper-evident security alert logs"
    },
    "/investigations/{investigationId}": {
      "schema": "Investigation",
      "description": "Investigations collection"
    },
    "/evidence/{evidenceId}": {
      "schema": "Evidence",
      "description": "Central evidence registry"
    },
    "/evidence/{evidenceId}/chain_of_custody/{entryId}": {
      "schema": "ChainOfCustody",
      "description": "History of evidence handling"
    },
    "/custody_ledger/{entryId}": {
      "schema": "CustodyLedgerEvent",
      "description": "Append-only investigator-wide cryptographic chain of custody ledger"
    },
    "/forensic_reports/{reportId}": {
      "schema": "ForensicReport",
      "description": "Immutable cryptographically sealed forensic report registry"
    },
    "/audit_logs/{logId}": {
      "schema": "AuditLog",
      "description": "Activity logs"
    }
  }
}
